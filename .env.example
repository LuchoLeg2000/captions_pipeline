# Copie ce fichier en `.env` a la racine du projet et renseigne les valeurs.
# Le `.env` reel est ignore par git (il contient des secrets).

# Cle API OpenRouter (format : sk-or-v1-...).
# Sert a generer l'histoire (modules/script_generator.py) et a choisir le
# theme narratif (modules/theme_selector.py).
OPENROUTER_API_KEY=

# Identifiant du modele OpenRouter a utiliser.
# Exemple : moonshotai/kimi-k2
OPENROUTER_MODEL=moonshotai/kimi-k2

# URL de base du backend qui expose GET /api/themes (sans slash final).
# Laisse la valeur par defaut si le backend tourne sur la meme machine que
# le pipeline ; sinon indique l'hote joignable (ex : http://178.104.242.50:8000).
BACKEND_URL=http://localhost:8000
